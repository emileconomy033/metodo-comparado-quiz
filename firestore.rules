rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function moderator() {
      return signed()
        && request.auth.token.email == 'emil.economia@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function validTimes(t, version) {
      return t is list
        && ((version == 3 && t.size() == 4) || (version == 2 && t.size() == 6))
        && t[0] is int && t[0] >= 10 && t[0] <= 180
        && t[1] is int && t[1] >= 10 && t[1] <= 180
        && t[2] is int && t[2] >= 10 && t[2] <= 180
        && t[3] is int && t[3] >= 10 && t[3] <= 180
        && (version != 2 || (t[4] is int && t[4] >= 10 && t[4] <= 180
          && t[5] is int && t[5] >= 10 && t[5] <= 180));
    }
    function parent(id) { return get(/databases/$(database)/documents/rooms/$(id)); }
    function owner(id) { return signed() && parent(id).data.owner == request.auth.uid; }
    function participant(id) { return signed() && exists(/databases/$(database)/documents/rooms/$(id)/participants/$(request.auth.uid)); }
    function coPresenter(id) {
      return signed() && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(/databases/$(database)/documents/rooms/$(id)/access/presenter)
        && get(/databases/$(database)/documents/rooms/$(id)/access/presenter).data.email == request.auth.token.email;
    }
    function presenter(id) { return owner(id) || coPresenter(id); }
    function approvedRoom(id) { return presenter(id) || participant(id); }
    match /rooms/{id} {
      allow get: if signed();
      allow list: if false;
      allow create: if moderator() && request.resource.data.keys().hasOnly(['owner','mode','sessionKind','questionTimes','quizVersion','revealStage','status','idx','reveal','openedAt','createdAt'])
        && request.resource.data.owner == request.auth.uid && request.resource.data.mode in ['survey','competition'] && request.resource.data.sessionKind in ['practice','official']
        && validTimes(request.resource.data.questionTimes, request.resource.data.quizVersion)
        && request.resource.data.quizVersion in [2,3] && request.resource.data.revealStage == 0
        && request.resource.data.status == 'lobby' && request.resource.data.idx == -1 && request.resource.data.reveal == false;
      allow update: if (owner(id) || (coPresenter(id) && resource.data.status != 'done' && request.resource.data.status != 'lobby' && request.resource.data.idx >= resource.data.idx))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','idx','reveal','revealStage','openedAt'])
        && request.resource.data.mode == resource.data.mode && request.resource.data.sessionKind == resource.data.sessionKind && request.resource.data.owner == resource.data.owner
        && (!('revealStage' in request.resource.data) || (request.resource.data.revealStage is int && request.resource.data.revealStage >= 0 && request.resource.data.revealStage <= 3))
        && request.resource.data.status in ['lobby','live','done'] && request.resource.data.idx >= -1 && request.resource.data.idx < (resource.data.get('quizVersion',1) == 3 ? 4 : 6);
      allow delete: if false;
      match /participants/{pid} {
        // El usuario puede consultar su propio documento, incluso antes de crearlo.
        // La lista completa queda restringida a miembros de la sala.
        allow get: if presenter(id) || (signed() && request.auth.uid == pid);
        allow list: if presenter(id);
        allow create: if signed() && request.auth.uid == pid && parent(id).data.status != 'done'
          && request.resource.data.keys().hasOnly(['name','country','joinedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 35
          && request.resource.data.country is string && request.resource.data.country.size() <= 40
          && request.resource.data.joinedAt == request.time;
        allow update: if false;
        allow delete: if owner(id) && parent(id).data.status == 'done';
      }
      match /answers/{qid}/votes/{pid} {
        // Participantes solo pueden consultar votos cuando ya se revelaron, o al cerrar.
        // En encuesta, los resultados individuales quedan reservados al moderador hasta el cierre.
        // La lectura de votos identificables está reservada al moderador y a su autor.
        // Las visualizaciones grupales se proyectan desde la pantalla del moderador.
        allow get: if presenter(id) || (signed() && request.auth.uid == pid && participant(id));
        allow list: if presenter(id);
        allow create: if signed() && request.auth.uid == pid && participant(id)
          && request.resource.data.keys().hasOnly(['choice','submittedAt'])
          && request.resource.data.choice is int && request.resource.data.choice >= 0 && request.resource.data.choice < 4
          && request.resource.data.submittedAt == request.time
          && parent(id).data.status == 'live'
          && ((parent(id).data.mode == 'survey' && int(qid) >= 0 && int(qid) < (parent(id).data.get('quizVersion',1) == 3 ? 4 : 6))
            || (parent(id).data.mode == 'competition' && int(qid) == parent(id).data.idx
              && parent(id).data.reveal == false && parent(id).data.get('revealStage',0) == 0 && request.time <= parent(id).data.openedAt + duration.value(parent(id).data.get('questionTimes',[40,40,40,40,40,40])[int(qid)],'s')));
        // Puede corregirse la opción propia mientras la pregunta permanezca abierta.
        // La última escritura aceptada por el servidor es la respuesta definitiva.
        allow update: if signed() && request.auth.uid == pid && participant(id)
          && request.resource.data.keys().hasOnly(['choice','submittedAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['choice','submittedAt'])
          && request.resource.data.choice is int && request.resource.data.choice >= 0 && request.resource.data.choice < 4
          && request.resource.data.submittedAt == request.time
          && parent(id).data.status == 'live'
          && ((parent(id).data.mode == 'survey' && int(qid) >= 0 && int(qid) < (parent(id).data.get('quizVersion',1) == 3 ? 4 : 6))
            || (parent(id).data.mode == 'competition' && int(qid) == parent(id).data.idx
              && parent(id).data.reveal == false && parent(id).data.get('revealStage',0) == 0
              && request.time <= parent(id).data.openedAt + duration.value(parent(id).data.get('questionTimes',[40,40,40,40,40,40])[int(qid)],'s')));
        allow delete: if owner(id) && parent(id).data.status == 'done';
      }
      match /access/{key} {
        allow get: if key == 'presenter' && (owner(id) || (signed() && request.auth.token.firebase.sign_in_provider == 'password' && resource.data.email == request.auth.token.email));
        allow list: if false;
        allow create, update: if key == 'presenter' && owner(id)
          && request.resource.data.keys().hasOnly(['email'])
          && request.resource.data.email is string
          && request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 254;
        allow delete: if key == 'presenter' && owner(id);
      }
    }
  }
}