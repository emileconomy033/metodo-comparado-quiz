rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function parent(id) { return get(/databases/$(database)/documents/rooms/$(id)); }
    function owner(id) { return signed() && parent(id).data.owner == request.auth.uid; }
    function participant(id) { return signed() && exists(/databases/$(database)/documents/rooms/$(id)/participants/$(request.auth.uid)); }
    function approvedRoom(id) { return owner(id) || participant(id); }
    match /rooms/{id} {
      allow get: if signed();
      allow list: if false;
      allow create: if signed() && request.resource.data.keys().hasOnly(['owner','mode','sessionKind','status','idx','reveal','openedAt','createdAt'])
        && request.resource.data.owner == request.auth.uid && request.resource.data.mode in ['survey','competition'] && request.resource.data.sessionKind in ['practice','official']
        && request.resource.data.status == 'lobby' && request.resource.data.idx == -1 && request.resource.data.reveal == false;
      allow update: if owner(id) && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','idx','reveal','openedAt'])
        && request.resource.data.mode == resource.data.mode && request.resource.data.sessionKind == resource.data.sessionKind && request.resource.data.owner == resource.data.owner
        && request.resource.data.status in ['lobby','live','done'] && request.resource.data.idx >= -1 && request.resource.data.idx < 6;
      allow delete: if false;
      match /participants/{pid} {
        // El usuario puede consultar su propio documento, incluso antes de crearlo.
        // La lista completa queda restringida a miembros de la sala.
        allow get: if approvedRoom(id) || (signed() && request.auth.uid == pid);
        allow list: if approvedRoom(id);
        allow create: if signed() && request.auth.uid == pid && parent(id).data.status != 'done'
          && request.resource.data.keys().hasOnly(['name','country','joinedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 35
          && request.resource.data.country is string && request.resource.data.country.size() <= 40;
        allow update, delete: if false;
      }
      match /answers/{qid}/votes/{pid} {
        // Participantes solo pueden consultar votos cuando ya se revelaron, o al cerrar.
        // En encuesta, los resultados individuales quedan reservados al moderador hasta el cierre.
        allow get: if owner(id) || (signed() && request.auth.uid == pid && participant(id)) || (participant(id) && (parent(id).data.status == 'done' || (parent(id).data.mode == 'competition' && parent(id).data.reveal == true && int(qid) == parent(id).data.idx)));
        allow list: if owner(id) || (participant(id) && (parent(id).data.status == 'done' || (parent(id).data.mode == 'competition' && parent(id).data.reveal == true && int(qid) == parent(id).data.idx)));
        allow create: if signed() && request.auth.uid == pid && participant(id)
          && request.resource.data.keys().hasOnly(['choice','submittedAt'])
          && request.resource.data.choice is int && request.resource.data.choice >= 0 && request.resource.data.choice < 4
          && request.resource.data.submittedAt == request.time
          && parent(id).data.status == 'live'
          && ((parent(id).data.mode == 'survey' && int(qid) >= 0 && int(qid) < 6)
            || (parent(id).data.mode == 'competition' && int(qid) == parent(id).data.idx
              && parent(id).data.reveal == false && request.time <= parent(id).data.openedAt + duration.value(40,'s')));
        allow update, delete: if false;
      }
    }
  }
}